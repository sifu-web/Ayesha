# ============================================
# Ayesha...💗  — Backend Environment Variables
# Copy this file to .env and fill in your values
#   cp .env.example .env
# ============================================

# Server
PORT=5000
# Use "development" for local testing (as CLIENT_URL below assumes).
# Set this to "production" only once both frontend and backend are deployed
# over HTTPS — see README §9 — otherwise the session cookie's Secure flag
# will stop it from being sent at all over plain http://localhost.
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_characters_long
JWT_EXPIRES_IN=2h
INACTIVITY_LOGOUT_MINUTES=15

# Default Administrator (used only on first run / seed, to create the initial account)
DEFAULT_ADMIN_USERNAME=Ayesha
DEFAULT_ADMIN_PASSWORD=mangomango

# Database — a PostgreSQL connection string from a free host such as
# Neon (neon.tech) or Render's own free Postgres. It looks like:
# postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=ayesha-gallery

# Total plan storage in bytes, used to compute "Available/Total Storage" on the dashboard.
# Cloudinary free tier = 25 GB = 26843545600 bytes. Adjust to your plan.
CLOUDINARY_PLAN_STORAGE_BYTES=26843545600
